{
  "name": "spicybettingsimulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fake-money sports betting simulator for NFL and college football, with real lines and real payouts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n fixtures,worker,web -c magenta,yellow,cyan \"npm:dev:fixtures\" \"npm:dev:worker\" \"npm:dev:web\"",
    "predev": "node -e \"require('node:fs').mkdirSync('dist/client',{recursive:true})\"",
    "dev:fixtures": "node scripts/fixture-server.mjs",
    "dev:worker": "wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "typecheck": "tsc -b --pretty",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node -e \"require('node:fs').mkdirSync('dist/client',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 migrations apply spicybetting --local",
    "db:migrate:remote": "wrangler d1 migrations apply spicybetting --remote",
    "db:console:local": "wrangler d1 execute spicybetting --local --command",
    "db:reconcile": "node scripts/reconcile.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "icons": "node scripts/icons.mjs",
    "deploy": "npm run build:web && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "miniflare": {
        "sharp": "0.35.4"
      }
    }
  }
}
