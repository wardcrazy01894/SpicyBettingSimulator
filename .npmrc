# Install-script policy (npm 11): a dependency with a preinstall/install/
# postinstall script must be listed in package.json "allowScripts" or the
# install FAILS instead of printing a warning nobody reads. Approve a new one
# with `npm approve-scripts --no-allow-scripts-pin <pkg>` after reading what
# its script does. CLAUDE.md, "Install scripts".
strict-allow-scripts=true
