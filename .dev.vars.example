# Copy to .dev.vars for local development. .dev.vars is gitignored — never commit it.

# IMPORTANT: this override is what makes `npm run dev` use the local fixture
# server (scripts/fixture-server.mjs on :8788) instead of the real ESPN API.
# Without it, wrangler.jsonc's default (https://site.api.espn.com) wins and local
# development hits production ESPN. Delete the line to test against real ESPN.
ESPN_BASE_URL="http://127.0.0.1:8788"

# Cookies: browsers treat http://localhost as a secure context, so "true" works
# locally. Set "false" only if you are testing over a plain-http LAN address.
COOKIE_SECURE="true"

# Shared invite code required at signup. Leave unset to allow open signup locally.
INVITE_CODE="local-dev-invite"

# Salt used to hash client IPs before they are written to auth_throttle.
IP_HASH_SALT="local-dev-ip-salt-change-me"

# In-app bug reports file GitHub issues. Leave GITHUB_TOKEN unset locally and the
# "Report a bug" form is hidden; set a fine-grained PAT (Issues: read+write on
# ONE repo) to exercise it against a scratch repo — never the real one from dev.
# GITHUB_TOKEN="github_pat_..."
# GITHUB_REPO="you/scratch-repo"

# The secondary odds provider (The Odds API, PLAN.md §21). Leave ODDS_API_KEY
# unset and the feature is OFF. Locally the fixture server also serves the
# committed docs/samples/odds-api-*.json at the real v4 path, so any non-empty
# key works against it without spending a credit; never point a real key at
# the real API from dev by accident — the free tier is 500 credits a month.
ODDS_API_BASE_URL=http://127.0.0.1:8788
# ODDS_API_KEY="any-value-for-the-fixture-server"
